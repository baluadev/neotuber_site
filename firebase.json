{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/playlist/**", "destination": "/index.html" },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
